---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoFrame from '../../components/VideoFrame.astro';

// The grader is a separate app on a separate deploy. `?embed=1` asks it for the
// chrome-less variant: form, result and legal notice, without the site header,
// footer, cookie notice and closing CTA that this page already provides.
const GRADER_ORIGIN = 'https://geo.binumi.com';

// What actually happens after a visitor submits, stated on the page.
// Deliberately NOT a promise of an emailed report: the grader app sends no mail at
// all. It has no mail dependency and no transactional provider. It renders the
// score in place and files the lead into HubSpot, and the breakdown is a human
// follow-up from there. Do not add a delivery time or an automated-send claim to
// this line until one of those genuinely exists.
// Frontmatter, not an HTML comment, so the rationale does not ship to production.
const FORM_NOTE = 'Your score appears here on screen as soon as the scan finishes. Whatever it says, it can be improved.';
---
<BaseLayout
  title="Binumi · AI visibility grader"
  description="Buyers ask AI before they ask you. See how effectively AI can understand, trust and use the knowledge on your page, and where valuable knowledge may be missing."
>
  <main>
    <!-- ===================== 1. URGENCY ===================== -->
    <section class="page-banner">
      <div class="container hero-inner">
        <h1>Buyers ask AI before they ask you</h1>
        <p class="lead">
          AI is rapidly becoming where buyers research complex products, expertise and suppliers
          before they reach your business. What AI understands, trusts and recommends can now
          influence who gets considered. Binumi shows you how effectively your expertise is
          represented, and where valuable knowledge may be missing.
        </p>
        <div class="banner-actions">
          <a class="btn btn-primary" href="#grader">Check your AI Visibility
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
        <!-- PLACEHOLDER: reusing the solutions hero film. There is no GEO-specific
             asset yet, and public/ holds no video at all, only posters. Swap the src
             and poster when one exists. -->
        <VideoFrame
          videoSrc="https://d27kwhqqz0gcvq.cloudfront.net/uploads/1__79e216f079172a5949cf8e11095f67a5_h169.mp4"
          poster="/solutions-hero-poster.jpg"
          label="Binumi proof overview video"
          autoplay muted loop
        />
      </div>
    </section>

    <!-- ===================== 2. SCORE ===================== -->
    <section class="section" id="score">
      <div class="container">
        <div class="split">
          <div class="copy-col">
            <h2>See what AI actually knows <span class="hl">about you</span></h2>
            <p class="lead">
              Binumi's AI Visibility Assessment analyzes your page to show how effectively AI can
              understand, trust and use the knowledge it contains. Your score reveals where you
              stand today, where important signals may be missing, and where the greatest
              opportunities lie.
            </p>
            <a class="btn btn-primary" href="#grader">Check your AI Visibility
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
          <!-- PLACEHOLDER: no asset yet. Add videoSrc and poster when one exists. -->
          <VideoFrame label="See what AI actually knows about you" />
        </div>
      </div>
    </section>

    <!-- ===================== 3. CREDIBILITY ===================== -->
    <section class="section" id="why">
      <div class="container">
        <div class="split split--flip">
          <!-- PLACEHOLDER: no asset yet. Add videoSrc and poster when one exists. -->
          <VideoFrame label="A score built on real AI visibility signals" />
          <div class="copy-col">
            <h2>A score built on <span class="hl">real AI visibility signals</span></h2>
            <p class="lead">
              This is not a superficial website grader. Binumi's assessment is built on deep
              analysis of the signals that influence how AI can understand, trust and use your
              knowledge. Developed by global leaders in digital communications, video and applied
              AI, it provides a serious measure of where your page stands today.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 4-7. KNOWLEDGE, VIDEO, SOLUTION, ENTERPRISE ===================== -->
    <section class="section" id="knowledge">
      <div class="container stack">
        <div class="intro">
          <h2>Your advantage is knowledge that <span class="hl">cannot be manufactured</span></h2>
          <p class="subtitle">
            AI can generate more content in a day than your team can review in a year. It cannot
            manufacture your expertise, technical knowledge, products, processes or evidence. That
            is exactly what makes complex B2B businesses valuable to AI. The problem is that much
            of this knowledge is still trapped in documents, systems and people, or has never been
            communicated at all.
          </p>
        </div>
        <div class="bento reveal">
          <div class="bento-card b-wide">
            <div class="icon"><span class="material-symbols-outlined" aria-hidden="true">movie</span></div>
            <h3>Video turns expertise into AI-visible knowledge</h3>
            <p>
              Your most valuable knowledge is often locked in complex documents, products,
              processes and people. Binumi turns that expertise into authoritative video, created
              and structured to be understood by people and AI, strengthening discovery, trust and
              visibility across your digital presence.
            </p>
          </div>
          <div class="bento-card b-cell">
            <div class="icon"><span class="material-symbols-outlined" aria-hidden="true">groups</span></div>
            <h3>We build the fix, not just the score</h3>
            <p>
              Binumi identifies what AI can see, what is missing and where the greatest
              opportunities lie. Then we improve what exists and create what is needed, turning
              complex products, documents, processes and expertise into AI-ready communications
              and video at enterprise scale.
            </p>
          </div>
          <div class="bento-card b-cell">
            <div class="icon"><span class="material-symbols-outlined" aria-hidden="true">verified_user</span></div>
            <h3>Built for enterprise</h3>
            <p>Secure, governed and designed for complex organizations.</p>
          </div>
          <div class="bento-card b-cell">
            <div class="icon"><span class="material-symbols-outlined" aria-hidden="true">trending_up</span></div>
            <h3>Created at scale</h3>
            <p>Turn complex knowledge into powerful video continuously and cost-effectively.</p>
          </div>
          <div class="bento-card b-cell">
            <div class="icon"><span class="material-symbols-outlined" aria-hidden="true">link</span></div>
            <h3>Visibility beyond your website</h3>
            <p>Help your expertise become discoverable across a wider digital ecosystem.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 8. COMMERCIAL RISK ===================== -->
    <section class="section" id="stakes">
      <div class="container">
        <div class="stakes-split">
          <div class="copy-col">
            <h2>What it costs when AI <span class="hl">answers without you</span></h2>
            <p class="lead">
              When AI cannot find enough credible knowledge about your business, it turns
              elsewhere, before a buyer ever reaches your business.
            </p>
          </div>
          <div class="stakes-grid reveal">
            <div>
              <h3>Your competitors become the recommendation</h3>
              <p>AI recommends whoever it can read and trust. If that is not you, the name a buyer hears first belongs to someone else.</p>
            </div>
            <div>
              <h3>Their expertise shapes the answer</h3>
              <p>The explanation a buyer receives is built from another company's knowledge, framed around their strengths and their way of solving the problem.</p>
            </div>
            <div>
              <h3>Your products never enter consideration</h3>
              <p>A buyer satisfied by the answer has no reason to keep looking. The shortlist forms without you on it.</p>
            </div>
            <div>
              <h3>You never learn the deal existed</h3>
              <p>No visit, no inquiry, no signal. The decision is shaped and the conversation is over before you knew it had started.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 9. THE GRADER ===================== -->
    <section class="section" id="grader">
      <div class="container stack">
        <div class="intro">
          <h2>Every page <span class="hl">matters</span></h2>
          <p class="subtitle">
            Start with one important product, service or expertise page and see how effectively
            AI can understand it.
          </p>
        </div>
        <div class="geo-embed">
          <iframe
            id="geo-grader"
            src={`${GRADER_ORIGIN}/?embed=1`}
            title="Binumi AI visibility grader"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            sandbox="allow-scripts allow-forms allow-same-origin allow-top-navigation-by-user-activation"
            scrolling="no"
          ></iframe>
          <p class="form-note">{FORM_NOTE}</p>
          <noscript>
            <p class="geo-embed-fallback">
              The grader needs JavaScript. <a href={GRADER_ORIGIN}>Open it directly</a>.
            </p>
          </noscript>
          <p class="geo-embed-fallback">
            Trouble loading? <a href={GRADER_ORIGIN}>Open the grader directly</a>, or
            <a href="/contact/">talk to us instead</a>.
          </p>
        </div>

      </div>
    </section>

    <!-- ===================== WHAT HAPPENS NEXT ===================== -->
    <section class="section">
      <div class="container stack">
        <div class="intro">
          <h2>A score now. <span class="hl">A conversation next</span></h2>
        </div>
        <div class="bento reveal">
          <div class="bento-card b-cell">
            <h3>Where you stand today</h3>
            <p>Your AI Visibility Score gives you an immediate view of how effectively AI can understand and trust the knowledge on your page.</p>
          </div>
          <div class="bento-card b-cell">
            <h3>A deeper assessment</h3>
            <p>Our team reviews your result and will reach out to explore what AI can see, what may be missing and where the greatest opportunities lie.</p>
          </div>
          <div class="bento-card b-cell">
            <h3>The solution</h3>
            <p>We show you how Binumi can improve what exists and create the knowledge and video needed to strengthen your AI visibility.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== CLOSING CTA ===================== -->
    <section class="section" id="cta">
      <div class="container">
        <div class="cta-card">
          <video class="cta-bg" src="https://d27kwhqqz0gcvq.cloudfront.net/uploads/1__e9fd886d8dacac140457e375d606c8a0_h169.mp4"
            data-autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
          <div class="inner">
            <h2>What changes when your business <span class="hl">becomes part of the&nbsp;answer</span>?</h2>
            <a class="btn btn-primary" href="/contact/">Start the conversation
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* No panel, no border, no fill. The grader is meant to read as part of the page,
     not as a window cut into it, so the only thing separating it from the page is
     the page background it inherits. */
  .geo-embed {
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }
  /* Centred to sit under the form rather than against the page's left edge. The form inside the
     frame is centred in its own document, so left-aligned text below it reads as belonging to the
     page rather than to the tool. */
  .geo-embed .form-note,
  .geo-embed .geo-embed-fallback { text-align: center; }
  /* The frame reports its own height and this follows it, so the grader grows and shrinks with
     its content and never scrolls inside the page. A cross-origin parent cannot measure its
     child, so that report is the only way to know: see the listener at the foot of this file.

     `scrolling="no"` is set on the element as well. It is only safe BECAUSE the height is driven
     by the report: with a fixed height it would clip the result and leave no way to reach it.
     The starting height is a first paint only, replaced within a frame of the iframe loading. */
  .geo-embed iframe {
    width: 100%;
    /* height is the reported value once the frame speaks. Until then min-height carries it, and
       it is deliberately generous: with scrolling off, a frame that is too SHORT clips its own
       form with no way to reach the rest, which is worse than any amount of blank space. The
       script clears the floor the moment a real height arrives. */
    height: 420px;
    min-height: 1120px;
    border: 0;
    display: block;
    background: transparent;
    overflow: hidden;
    transition: height .2s ease;
  }
  @media (min-width: 481px) { .geo-embed iframe { min-height: 860px; } }
  @media (min-width: 721px) { .geo-embed iframe { min-height: 690px; } }
  @media (prefers-reduced-motion: reduce) {
    .geo-embed iframe { transition: none; }
  }
  .geo-embed-fallback { color: var(--muted); font-size: .9rem; margin: 0; }
  .geo-embed-fallback a { color: var(--cyan); text-decoration: underline; }
  /* The next-step line. Deliberately a step up from .geo-embed-fallback below it:
     that one is troubleshooting and should read as fine print, this one answers
     "what happens after I submit" and has to be seen. */
  .form-note { color: var(--ink); font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; margin: 0; }

  /* Copy and video share the row evenly here, not the site's 5/6 split, so the two
     alternating frames line up at the same width. The frame fills its column. */
  #score .split, #why .split { grid-template-columns: 1fr 1fr; }
  #score .video-master, #why .video-master { width: 100%; max-width: none; }
  #score .copy-col h2, #why .copy-col h2 { max-width: none; text-wrap: balance; }
  #score .copy-col .lead, #why .copy-col .lead { max-width: none; }
  @media (max-width: 980px) {
    #score .split, #why .split { grid-template-columns: 1fr; }
  }

  /* Heading and lead on the left, four bare points on the right. No cards: these are
     consequences, not features, and the section above is already a bento. */
  .stakes-split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--gap); align-items: start; }
  .stakes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); }
  .stakes-grid h3 { font-size: var(--t-h6); margin-bottom: .6rem; }
  .stakes-grid p { color: var(--muted); font-size: .98rem; }
  @media (max-width: 980px) {
    .stakes-split { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .stakes-grid { grid-template-columns: 1fr; }
  }

  /* The results row is three cells on the six-column bento, so it fills one row
     exactly. Without icons: these are outcomes, not features. */
  #cta .cta-card h2 { max-width: 22ch; text-wrap: balance; }

</style>

<script>
  // The grader grows when a result lands, so it tells us its height and we resize
  // the frame to match. Everything here is a guard: the message has to come from
  // the grader's exact origin AND from this specific frame, carry our namespaced
  // type, and pass a finite number inside a sane range. Anything else is ignored.
  // Derived from the frame itself, not written down a second time. The origin we accept messages
  // from and the origin we loaded MUST be the same string, and the way that guarantee fails is a
  // second copy of the constant that someone updates only in one place.
  const frameEl = document.getElementById('geo-grader') as HTMLIFrameElement | null;
  const GRADER_ORIGIN = frameEl && new URL(frameEl.src, location.href).origin;
  const MIN_H = 200;
  const MAX_H = 4000;

  if (frameEl) {
    const frame = frameEl;
    window.addEventListener('message', (event: MessageEvent) => {
      if (event.origin !== GRADER_ORIGIN) return;
      if (event.source !== frame.contentWindow) return;
      const data = event.data;
      if (!data || data.type !== 'binumi:geo:height') return;
      const height = Number(data.height);
      if (!Number.isFinite(height)) return;
      // The frame has spoken, so the pre-handshake floor is no longer needed and would now only
      // hold the frame open on empty space. Drop it and let the reported height govern.
      frame.style.minHeight = '0';
      frame.style.height = Math.min(Math.max(height, MIN_H), MAX_H) + 'px';
    });

    // Say hello once the frame is up. The frame reports its height unprompted too, but this
    // script is a deferred module: a frame served from a fast origin can load and report before
    // the listener above exists, and that report is then simply lost. The ping closes that race.
    frame.addEventListener('load', () => {
      if (!GRADER_ORIGIN) return;
      frame.contentWindow?.postMessage({ type: 'binumi:geo:hello' }, GRADER_ORIGIN);
    });
    // And once more for the case where the frame finished loading before we got here at all.
    if (GRADER_ORIGIN) {
      frame.contentWindow?.postMessage({ type: 'binumi:geo:hello' }, GRADER_ORIGIN);
    }
  }
</script>
